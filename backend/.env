#App
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27019/file-central

#JWT
JWT_SECRET=development-only-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# MinIO
MINIO_ENDPOINT=192.168.177.128
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=file-central

# Upload limits
MAX_UPLOAD_SIZE_MB=200

PUBLIC_BASE_URL=http://localhost:3000


API_PREFIX=api

CORS_ORIGINS=http://localhost:3030,http://localhost:5173

MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20
MONGODB_AUTO_INDEX=true

LOG_LEVEL=debug
LOG_PRETTY=true

MAX_FOLDER_DEPTH=256

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=file-central
STORAGE_REGION=us-east-1
